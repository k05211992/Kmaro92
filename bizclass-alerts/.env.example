# =============================================================================
# BizClass Alerts — Environment Variables
# Copy to .env.local and fill in your values.
# Variables marked [required] must be set before the app will start.
# Variables marked [optional] have sensible defaults shown below.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase [required] ─────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Database connection strings
# Dashboard → Project Settings → Database → Connection string
# Use "Transaction pooler" URL for DATABASE_URL (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use "Session pooler" or "Direct connection" URL for DIRECT_URL (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Feature flag: Flight Data Provider ──────────────────────────────────────
# Set USE_MOCK_PROVIDER=true to use generated fake offers (no API key needed).
# Set to false and configure a real provider below for production.
USE_MOCK_PROVIDER=true
FLIGHT_PROVIDER=mock

# Amadeus (only when FLIGHT_PROVIDER=amadeus and USE_MOCK_PROVIDER=false)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# Duffel (only when FLIGHT_PROVIDER=duffel and USE_MOCK_PROVIDER=false)
DUFFEL_ACCESS_TOKEN=

# ─── Telegram Bot [required for notifications] ───────────────────────────────
# Create a bot via @BotFather → /newbot → copy the token
TELEGRAM_BOT_TOKEN=<bot-token>
# Username without @, e.g. mybizclassbot
TELEGRAM_BOT_USERNAME=<bot-username>
# Random string used to verify Telegram webhook calls.
# Generate with: openssl rand -hex 20
TELEGRAM_WEBHOOK_SECRET=<random-secret>

# ─── Cron [required for automated price checks] ──────────────────────────────
# Random secret sent as Authorization: Bearer <secret> to /api/cron/check-alerts
# Generate with: openssl rand -hex 20
CRON_SECRET=<random-secret>

# ─── Business Logic [optional] ───────────────────────────────────────────────
# Alert the user when price drops by at least this % vs the previously seen best
PRICE_DROP_PERCENT=10
# Maximum alerts a user can have active at once
MAX_ALERTS_PER_USER=10
# Hour (UTC) at which daily digest notifications are sent (0-23)
DAILY_DIGEST_HOUR_UTC=8
# Default currency for new alerts
DEFAULT_CURRENCY=EUR

# ─── Email Notifications [optional] ─────────────────────────────────────────
# Used when a user has no Telegram account linked.
# Sign up at https://resend.com — free tier: 3,000 emails/month.
RESEND_API_KEY=
# Sender address. Must be verified in Resend dashboard (or use onboarding@resend.dev for testing).
EMAIL_FROM=BizClass Alerts <onboarding@resend.dev>

# ─── AI Layer [optional] ─────────────────────────────────────────────────────
# Leave empty to skip AI-generated offer summaries (recommended for local dev)
OPENAI_API_KEY=
