generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enums — all enum-like fields use String.
// Valid values are enforced at the application layer (Zod, TypeScript).

model User {
  id                    String    @id
  email                 String    @unique
  telegramChatId        String?   @map("telegram_chat_id")
  telegramUsername      String?   @map("telegram_username")
  telegramLinkToken     String?   @map("telegram_link_token")
  telegramLinkExpiresAt DateTime? @map("telegram_link_expires_at")
  telegramConnectedAt   DateTime? @map("telegram_connected_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  alerts        Alert[]
  notifications Notification[]

  @@index([telegramChatId])
  @@index([telegramLinkToken])
  @@map("users")
}

model Alert {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  status             String    @default("active")   // active | paused | archived
  origin             String
  destination        String
  tripType           String    @map("trip_type")    // one_way | round_trip
  departDateFrom     DateTime  @map("depart_date_from")
  departDateTo       DateTime? @map("depart_date_to")
  returnDateFrom     DateTime? @map("return_date_from")
  returnDateTo       DateTime? @map("return_date_to")
  cabinClass         String    @default("business") @map("cabin_class")
  maxPrice           Float     @map("max_price")
  currency           String
  maxStops           Int       @default(1) @map("max_stops")
  maxDurationMinutes Int?      @map("max_duration_minutes")
  nearbyAirports     Boolean   @default(false) @map("nearby_airports")
  notifFrequency     String    @default("instant") @map("notif_frequency")  // instant | daily_digest
  lastCheckedAt      DateTime? @map("last_checked_at")
  bestPriceSeen      Float?    @map("best_price_seen")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  flightOffers  FlightOffer[]
  notifications Notification[]
  searchRuns    SearchRun[]

  @@index([userId, status])
  @@index([lastCheckedAt])
  @@map("alerts")
}

model SearchRun {
  id              String   @id @default(uuid())
  alertId         String   @map("alert_id")
  provider        String
  runAt           DateTime @default(now()) @map("run_at")
  durationMs      Int?     @map("duration_ms")
  rawResultsCount Int      @default(0) @map("raw_results_count")
  filteredCount   Int      @default(0) @map("filtered_count")
  worthyCount     Int      @default(0) @map("worthy_count")
  status          String   @default("ok")   // ok | empty | error
  errorMessage    String?  @map("error_message")

  alert        Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  flightOffers FlightOffer[]

  @@index([alertId, runAt(sort: Desc)])
  @@map("search_runs")
}

model FlightOffer {
  id              String    @id @default(uuid())
  alertId         String    @map("alert_id")
  searchRunId     String?   @map("search_run_id")
  provider        String
  origin          String
  destination     String
  departAt        DateTime  @map("depart_at")
  arriveAt        DateTime  @map("arrive_at")
  returnDepartAt  DateTime? @map("return_depart_at")
  returnArriveAt  DateTime? @map("return_arrive_at")
  price           Float
  currency        String
  stops           Int
  durationMinutes Int       @map("duration_minutes")
  isFullBusiness  Boolean   @default(true) @map("is_full_business")
  airlineCodes    String    @map("airline_codes")   // JSON array string
  deepLink        String    @map("deep_link")
  rawData         String    @map("raw_data")        // JSON string
  hashForDedup    String    @unique @map("hash_for_dedup")
  foundAt         DateTime  @default(now()) @map("found_at")

  alert         Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  searchRun     SearchRun?     @relation(fields: [searchRunId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([alertId, foundAt(sort: Desc)])
  @@index([searchRunId])
  @@map("flight_offers")
}

model Notification {
  id           String    @id @default(uuid())
  alertId      String    @map("alert_id")
  offerId      String    @map("offer_id")
  userId       String    @map("user_id")
  channel      String    // telegram | email
  reason       String    // below_threshold | price_drop
  aiInsight    String?   @map("ai_insight")
  status       String    @default("pending")  // pending | sent | failed
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  alert Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  offer FlightOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId, sentAt(sort: Desc)])
  @@index([offerId, channel])
  @@map("notifications")
}
